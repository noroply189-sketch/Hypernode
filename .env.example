# ==============================================================================
# ALFRIANCLOUD ANDROID VPS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port provided automatically by Railway (defaults to 3000 locally)
PORT=3000

# Public or private application URL
APP_URL=https://your-railway-app.up.railway.app

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Security: Master Admin Password for ALFRIANCLOUD Dashboard
# Change this immediately in production!
ADMIN_PASSWORD=admin12345
SESSION_SECRET=change-this-to-a-very-secure-random-jwt-secret-key-32chars

# Android VPS Node Connection Configuration
# NOTE: Because Railway containers cannot load kernel modules (binder_linux)
# or nested KVM (/dev/kvm), Android (Redroid) runs on your dedicated Linux VPS
# and connects via this secure internal endpoint (WireGuard / Tailscale / SSH Tunnel).
DEFAULT_ANDROID_HOST=10.0.0.2
DEFAULT_ANDROID_ADB_PORT=5555
ANDROID_AUTH_TOKEN=alfrian-secure-token-vps-2026

# Screen Streaming Configuration
STREAM_MAX_FPS=30
STREAM_DEFAULT_BITRATE=2000000
SCREEN_DEFAULT_WIDTH=720
SCREEN_DEFAULT_HEIGHT=1280
SCREEN_DEFAULT_DPI=320

# Storage & Upload Limits
MAX_APK_UPLOAD_SIZE_MB=150
UPLOAD_DIR=/tmp/alfrian-apks

# Gemini AI API Key (Optional: for AI Assistant / Diagnostic logs)
GEMINI_API_KEY=
